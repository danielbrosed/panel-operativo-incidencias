APP_NAME="Panel operativo de incidencias"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0.17+ (developed and tested on 8.4 LTS). Create the database first, see README.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=incidents
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

INERTIA_SSR_ENABLED=false
# Inertia's DevTools record requests on disk and serve them without authentication: off unless you need them.
INERTIA_DEVTOOLS_ENABLED=false

# Content-Security-Policy, see config/security.php. Unset, it is "report" with APP_ENV=local (violations only show
# in the browser console) and "enforce" anywhere else. "off" disables it; any other value enforces.
# CSP_MODE=enforce
