includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app
        - bootstrap/app.php
        # Only the config files written for this project; the rest are the framework skeleton, untouched.
        - config/incidents.php
        - config/inertia.php
        - config/security.php
        - database
        - routes
        - tests
    tmpDir: storage/framework/phpstan
